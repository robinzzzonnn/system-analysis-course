@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

:root {
    --bg-dark: #0f172a;
    --bg-card: #1e293b;
    --bg-light: #111827;
    --text-primary: #f1f5f9;
    --text-secondary: #94a3b8;
    --accent-blue: #3b82f6;
    --accent-teal: #06b6d4;
    --accent-hover: #60a5fa;
    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
    --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    --transition: all 0.2s ease;
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
}

@keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
@keyframes gradientShift { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes float { 0% { transform: translate(0, 0) scale(1); } 50% { transform: translate(30px, -50px) scale(1.1); } 100% { transform: translate(0, 0) scale(1); } }

.spinner {
    display: inline-block; width: 16px; height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.3); border-top-color: #ffffff;
    border-radius: 50%; animation: spin 0.6s linear infinite;
    margin-right: 8px; vertical-align: middle;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    line-height: 1.6; color: var(--text-primary);
    background-color: var(--bg-dark); min-height: 100vh;
}

.container { width: 90%; max-width: 1200px; margin: 0 auto; padding: 0 2rem; }

.header { background-color: var(--bg-light); box-shadow: var(--shadow-md); position: sticky; top: 0; z-index: 100; }
.header .container { display: flex; justify-content: space-between; align-items: center; padding: 1rem 0; }
.logo h1 { font-size: 1.5rem; color: var(--text-primary); font-weight: 700; }
.nav { display: flex; gap: 1.5rem; }
.nav-link { text-decoration: none; color: var(--text-secondary); font-weight: 500; transition: var(--transition); padding: 0.5rem 0; }
.nav-link:hover { color: var(--accent-blue); }
.nav-link.active { color: var(--accent-blue); font-weight: 600; }

.main { min-height: calc(100vh - 120px); padding: 2rem 0; }
.hero { text-align: center; padding: 4rem 0; background: linear-gradient(135deg, var(--bg-light) 0%, var(--bg-card) 100%); background-size: 200% 200%; border-radius: var(--radius-md); margin-bottom: 3rem; animation: gradientShift 10s ease infinite; position: relative; overflow: hidden; }
.hero h2 { font-size: 2.5rem; margin-bottom: 1.5rem; color: var(--text-primary); font-weight: 700; line-height: 1.2; }
.hero-description { font-size: 1.2rem; color: var(--text-secondary); max-width: 700px; margin: 0 auto 2rem; line-height: 1.7; }
.hero-buttons { display: flex; justify-content: center; gap: 1rem; margin-top: 2rem; flex-wrap: wrap; }

.blob { position: absolute; border-radius: 50%; filter: blur(80px); z-index: -1; opacity: 0.4; }
.blob-1 { width: 400px; height: 400px; background: var(--accent-blue); top: -100px; left: -100px; animation: float 10s infinite ease-in-out; }
.blob-2 { width: 300px; height: 300px; background: var(--accent-teal); bottom: -50px; right: -50px; animation: float 12s infinite ease-in-out reverse; }

.btn { display: inline-block; text-decoration: none; padding: 0.75rem 1.5rem; border-radius: var(--radius-sm); font-weight: 600; cursor: pointer; text-align: center; transition: var(--transition); border: none; font-family: 'Inter', sans-serif; font-size: 1rem; box-shadow: var(--shadow-sm); }
.btn-primary { background: linear-gradient(135deg, var(--accent-blue) 0%, #2563eb 100%); color: white; }
.btn-primary:hover { background: linear-gradient(135deg, var(--accent-hover) 0%, #3b82f6 100%); transform: translateY(-2px); box-shadow: var(--shadow-md); }
.btn-secondary { background-color: var(--bg-card); color: var(--text-primary); border: 1px solid var(--text-secondary); }
.btn-secondary:hover { background-color: rgba(59, 130, 246, 0.1); border-color: var(--accent-blue); transform: translateY(-2px); box-shadow: var(--shadow-md); }
.full-width { width: 100%; }

.features { padding: 4rem 0; margin-bottom: 3rem; }
.features h3 { text-align: center; font-size: 2rem; margin-bottom: 3rem; color: var(--text-primary); font-weight: 700; }
.features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; }
.feature-card { background-color: var(--bg-card); padding: 2rem; border-radius: var(--radius-md); text-align: center; transition: var(--transition); box-shadow: var(--shadow-sm); border: 1px solid rgba(59, 130, 246, 0.1); opacity: 0; animation: fadeInUp 0.6s forwards; }
.feature-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); border-color: rgba(59, 130, 246, 0.3); }
.feature-icon { font-size: 2.5rem; margin-bottom: 1rem; color: var(--accent-blue); }
.feature-card h4 { font-size: 1.25rem; margin-bottom: 0.5rem; color: var(--text-primary); font-weight: 600; }
.feature-card p { color: var(--text-secondary); }

/* Auth */
.auth-section { display: flex; align-items: center; justify-content: center; min-height: 70vh; }
.auth-form-container { background-color: var(--bg-card); padding: 2rem; border-radius: var(--radius-md); box-shadow: var(--shadow-md); width: 100%; max-width: 450px; border: 1px solid rgba(59, 130, 246, 0.2); }
.auth-form-container h2 { text-align: center; margin-bottom: 1.5rem; color: var(--text-primary); font-weight: 700; }
.form-group { margin-bottom: 1.5rem; }
.form-group label { display: block; margin-bottom: 0.5rem; font-weight: 500; color: var(--text-primary); }
.form-group input { width: 100%; padding: 0.75rem; border: 1px solid #334155; border-radius: var(--radius-sm); font-size: 1rem; font-family: 'Inter', sans-serif; background-color: var(--bg-light); color: var(--text-primary); }
.form-group input:focus { outline: none; border-color: var(--accent-blue); box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2); }
.form-footer { text-align: center; margin-top: 1.5rem; color: var(--text-secondary); }
.form-footer a { color: var(--accent-blue); text-decoration: none; font-weight: 500; }

/* Choose Page */
.choice-container { display: flex; justify-content: center; gap: 2rem; flex-wrap: wrap; margin-top: 2rem; }
.choice-card { background-color: var(--bg-card); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: var(--radius-md); padding: 3rem 2rem; width: 320px; text-align: center; text-decoration: none; color: var(--text-primary); transition: var(--transition); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; align-items: center; }
.choice-card:hover { transform: translateY(-10px) scale(1.02); border-color: var(--accent-blue); box-shadow: 0 10px 30px rgba(59, 130, 246, 0.2); }
.choice-icon { font-size: 4rem; margin-bottom: 1.5rem; }
.choice-card h3 { font-size: 1.5rem; margin-bottom: 1rem; color: var(--accent-blue); font-weight: 700; }
.choice-card p { color: var(--text-secondary); font-size: 1rem; line-height: 1.5; }

/* Dashboard & Lessons */
.dashboard-section { padding: 2rem 0; }
.dashboard-section h2 { text-align: center; margin-bottom: 2rem; color: var(--text-primary); font-weight: 700; }
.welcome-message { text-align: center; margin-bottom: 3rem; padding: 1.5rem; background-color: var(--bg-card); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); border: 1px solid rgba(59, 130, 246, 0.2); }
.lessons-section h3 { margin-bottom: 1.5rem; color: var(--text-primary); text-align: center; font-weight: 700; }
.lessons-list { display: flex; flex-direction: column; gap: 1.5rem; }
.lesson-card { display: flex; align-items: center; background-color: var(--bg-card); border-radius: var(--radius-md); padding: 1.5rem; box-shadow: var(--shadow-sm); transition: var(--transition); border: 1px solid rgba(59, 130, 246, 0.1); }
.lesson-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: rgba(59, 130, 246, 0.3); }
.lesson-number { background-color: rgba(59, 130, 246, 0.1); color: var(--accent-blue); width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.25rem; margin-right: 1.5rem; flex-shrink: 0; }
.lesson-content h4 { font-size: 1.25rem; margin-bottom: 0.5rem; color: var(--text-primary); font-weight: 600; }
.lesson-content p { color: var(--text-secondary); }
.lesson-status .status { padding: 0.5rem 1rem; border-radius: 9999px; font-weight: 500; font-size: 0.875rem; }
.status.completed { background-color: rgba(16, 185, 129, 0.1); color: var(--success); }
.status.in-progress { background-color: rgba(245, 158, 11, 0.1); color: var(--warning); }
.status.locked { background-color: rgba(107, 114, 128, 0.1); color: var(--text-secondary); }

/* Lesson Page */
.lesson-section { padding: 2rem 0; }
.progress-container { margin-bottom: 2rem; }
.progress-bar { width: 100%; height: 10px; background-color: #334155; border-radius: 5px; overflow: hidden; margin-bottom: 0.5rem; }
.progress-fill { height: 100%; background: linear-gradient(90deg, var(--accent-blue) 0%, var(--accent-teal) 100%); width: 0%; transition: width 0.3s ease; }
.progress-text { text-align: center; color: var(--text-secondary); font-size: 0.9rem; }
.lesson-content-container { background-color: var(--bg-card); border-radius: var(--radius-md); padding: 2rem; box-shadow: var(--shadow-sm); border: 1px solid rgba(59, 130, 246, 0.1); }
.lesson-content-container h2 { margin-bottom: 1.5rem; color: var(--text-primary); text-align: center; font-weight: 700; }
.lesson-question h3 { font-size: 1.25rem; margin-bottom: 1rem; color: var(--text-primary); font-weight: 600; }
.options-container { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem; }
.option-button { background-color: var(--bg-card); border: 2px solid #334155; border-radius: var(--radius-sm); padding: 1rem; text-align: left; cursor: pointer; transition: var(--transition); font-family: 'Inter', sans-serif; font-size: 1rem; color: var(--text-primary); }
.option-button:hover { background-color: rgba(59, 130, 246, 0.1); border-color: var(--accent-blue); }
.option-button.selected { background-color: rgba(59, 130, 246, 0.1); border-color: var(--accent-blue); color: var(--accent-blue); font-weight: 500; }
.option-button.correct { background-color: rgba(16, 185, 129, 0.1); border-color: var(--success); color: var(--success); }
.option-button.incorrect { background-color: rgba(239, 68, 68, 0.1); border-color: var(--danger); color: var(--danger); }
.answer-container { background-color: rgba(59, 130, 246, 0.1); border-left: 4px solid var(--accent-blue); padding: 1.5rem; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; margin-bottom: 1.5rem; color: var(--text-primary); }
.theory-container { background-color: rgba(59, 130, 246, 0.05); border-left: 4px solid var(--accent-blue); padding: 2rem; max-width: 700px; margin: 0 auto 1.5rem; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; border: 1px solid rgba(59, 130, 246, 0.1); }
.theory-container h4 { color: var(--accent-blue); margin-bottom: 0.5rem; font-weight: 600; }
.theory-container p { line-height: 1.7; margin-bottom: 1rem; color: var(--text-primary); }

/* Simulator */
.simulator-dialogue { text-align: center; padding: 2rem 0; }
.simulator-avatar { width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, #3b82f6, #06b6d4); display: flex; align-items: center; justify-content: center; font-size: 1.8rem; box-shadow: 0 4px 10px rgba(59, 130, 246, 0.3); margin: 0 auto 1rem auto; }
.simulator-speaker { font-size: 1.2rem; font-weight: 600; color: var(--accent-blue); margin-bottom: 1rem; }
.simulator-message { font-size: 1.1rem; line-height: 1.6; color: var(--text-primary); background-color: var(--bg-light); padding: 1.5rem; border-radius: var(--radius-md); margin-bottom: 2rem; text-align: left; min-height: 80px; }
.simulator-choices { display: flex; flex-direction: column; gap: 1rem; max-width: 600px; margin: 0 auto; }
.simulator-choice { text-align: left; padding: 1rem; border-radius: var(--radius-sm); background-color: var(--bg-card); border: 1px solid #334155; color: var(--text-primary); cursor: pointer; transition: var(--transition); }
.simulator-choice:hover { background-color: rgba(59, 130, 246, 0.1); border-color: var(--accent-blue); }
.simulator-choice:disabled { opacity: 0.6; cursor: not-allowed; }
.simulator-feedback { padding: 1rem; border-radius: var(--radius-sm); margin: 1rem 0; font-weight: 500; }
.simulator-feedback.correct { background-color: rgba(16, 185, 129, 0.1); border: 1px solid var(--success); color: var(--success); }
.simulator-feedback.incorrect { background-color: rgba(239, 68, 68, 0.1); border: 1px solid var(--danger); color: var(--danger); }
.simulator-input { width: 100%; max-width: 600px; padding: 1rem; border-radius: var(--radius-sm); background-color: var(--bg-light); border: 1px solid #334155; color: var(--text-primary); font-family: 'Inter', sans-serif; font-size: 1rem; margin-bottom: 1rem; }
.simulator-input:focus { outline: none; border-color: var(--accent-blue); }
.simulator-summary { text-align: center; }
.simulator-summary h2 { color: var(--accent-blue); margin-bottom: 1rem; }

/* Footer */
.footer { background-color: var(--bg-light); color: var(--text-secondary); text-align: center; padding: 1.5rem 0; margin-top: 3rem; }

@media (max-width: 768px) {
    .header .container { flex-direction: column; gap: 1rem; }
    .hero h2 { font-size: 2rem; }
    .hero-buttons { flex-direction: column; }
    .features-grid { grid-template-columns: 1fr; }
    .lesson-card { flex-direction: column; text-align: center; }
    .lesson-number { margin: 0 0 1rem 0; }
    .lesson-navigation { flex-direction: column; }
    .btn { width: 100%; }
    .container { padding: 0 1rem; }
    .choice-container { flex-direction: column; align-items: center; }
    .choice-card { width: 100%; max-width: 320px; }
}